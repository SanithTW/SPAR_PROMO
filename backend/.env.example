PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spar_promo?schema=public"
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="24h"
CORS_ORIGIN="http://localhost:5173"

PRODUCT_MASTER_API_URL=http://127.0.0.1:8001
PRODUCT_MASTER_API_USERNAME=
PRODUCT_MASTER_API_PASSWORD=
PRODUCT_MASTER_API_TIMEOUT=10000

SALES_API_URL=http://127.0.0.1:8000
SALES_API_USERNAME=
SALES_API_PASSWORD=
SALES_API_TIMEOUT=10000

# Set to true ONLY for offline development: starts fake Product Master/Sales APIs on 8001/8000
USE_MOCK_EXTERNAL_APIS=false

# Microsoft Fabric (Warehouse / Lakehouse SQL analytics endpoint)
# Server: Fabric > Warehouse > Settings > SQL connection string, e.g. abc123.datawarehouse.fabric.microsoft.com
# Login: an Entra ID app registration (service principal) with Viewer access to the workspace
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_SQL_TIMEOUT=30000
